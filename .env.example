# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# backend-api-service base URL (server-side only, never exposed to the browser)
BACKEND_API_BASE_URL=https://your-backend-api.onrender.com

# Public (browser-exposed) WebSocket URL for backend-api's realtime endpoint.
# The browser connects here DIRECTLY (bypassing this frontend's own server/
# proxy layer) since backend-api runs on Azure Container Apps, an always-on
# container with no serverless-function duration cap - unlike the private
# BACKEND_API_BASE_URL above, this one must use the wss:// scheme and be
# reachable straight from the browser.
NEXT_PUBLIC_BACKEND_WS_URL=wss://your-backend-api.azurecontainerapps.io/ws/conversations
